{
  "expo": {
    "name": "GymRat",
    "slug": "gymrat",
    "version": "1.0.0",
    "scheme": "gymrat",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.gymrat.app",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GymRat to choose Library thumbnails.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
